        "type": "configStore",
        "config": {
          "readLatencyMs": 2,
          "writeLatencyMs": 4,
          "cacheHitRatio": 0.9
        },
        "description": "Shared versioned routing configuration store. Gateways watch it and reload routing table versions live without restarting."
      }
    },
    {
      "id": "sm-1",
      "type": "component",
      "position": {
        "x": 380,
        "y": 680
      },
      "data": {
        "label": "Secret Manager",
        "type": "secretManager",
        "config": {
          "readLatencyMs": 2,
          "keyRotationIntervalMs": 30000,
          "storesTlsCertificates": true
        },
        "description": "Central secret store for JWT signing/public keys and TLS certificates. Gateways fetch secrets at startup and on key rotation."
      }
    }
