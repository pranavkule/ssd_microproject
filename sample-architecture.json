{
  "id": "default-case-study",
  "name": "Dynamic L7 API Gateway & Reverse Proxy",
  "description": "This system is a high-performance L7 API gateway and reverse proxy. A Rate Limiter drops excess traffic, and a Load Balancer spreads requests across multiple gateway instances running on cloud compute. Each gateway verifies the client's JWT using keys fetched from a Secret Manager, then routes the request to the User, Product, or Order service by URL path. Routing rules live in a shared Config Store that the gateways watch, so rules reload live without restarting. Each service has its own database.",
  "nodes": [
    {
      "id": "client-1",
      "type": "component",
      "position": {
        "x": 40,
        "y": 300
      },
      "data": {
        "label": "Web Client",
        "type": "client",
        "config": {
          "requestRate": 50,
          "requestMix": [
            {
              "path": "/users/profile",
              "method": "GET",
              "weight": 30
            },
            {
              "path": "/products/list",
              "method": "GET",
              "weight": 40
            },
            {
              "path": "/orders",
              "method": "POST",
              "weight": 20
            },
            {
              "path": "/orders/1001",
              "method": "GET",
              "weight": 10
            }
          ],
          "timeoutMs": 4000,
          "burst": 0
        },
        "description": "Generates synthetic HTTP requests according to the configured rate and request mix. Enforces its own request timeout."
      }
    },
    {
      "id": "rl-1",
      "type": "component",
      "position": {
        "x": 230,
        "y": 300
      },
      "data": {
        "label": "Rate Limiter",
        "type": "rateLimiter",
        "config": {
          "requestsPerSecond": 60,
          "burstCapacity": 30,
          "strategy": "token-bucket",
          "scope": "global",
          "perRouteLimits": []
        },
        "description": "Admission control. Applies a token bucket or fixed window policy and rejects excess traffic with HTTP 429."
      }
    },
    {
      "id": "lb-1",
      "type": "component",
      "position": {
        "x": 430,
        "y": 300
      },
      "data": {
        "label": "Load Balancer",
        "type": "loadBalancer",
        "config": {
          "algorithm": "round-robin",
          "weights": {},
          "healthCheckIntervalMs": 1000,
          "capacity": 200,
          "serviceTimeMs": 1,
          "queueLimit": 1000
        },
        "description": "Selects a healthy gateway VM using Round Robin, Least Connections or Weighted Round Robin and forwards the request."
      }
    },
    {
      "id": "gw-1",
      "type": "component",
      "position": {
        "x": 640,
        "y": 150
      },
      "data": {
        "label": "Gateway VM 1",
        "type": "gateway",
        "config": {
          "instanceName": "gateway-vm-1 (JWT Verify)",
          "capacity": 60,
          "serviceTimeMs": 6,
          "queueLimit": 200,
          "authEnabled": true,
          "authFailureRate": 0,
          "timeoutMs": 2000,
          "maxRetries": 1
        },
        "description": "Layer-7 gateway VM. Verifies the client JWT with keys from the Secret Manager, matches the request path against the active routing table and forwards to a backend service."
      }
    },
    {
      "id": "gw-2",
      "type": "component",
      "position": {
        "x": 640,
        "y": 450
      },
      "data": {
        "label": "Gateway VM 2",
        "type": "gateway",
        "config": {
          "instanceName": "gateway-vm-2 (JWT Verify)",
          "capacity": 60,
          "serviceTimeMs": 6,
          "queueLimit": 200,
          "authEnabled": true,
          "authFailureRate": 0,
          "timeoutMs": 2000,
          "maxRetries": 1
        },
        "description": "Layer-7 gateway VM. Verifies the client JWT with keys from the Secret Manager, matches the request path against the active routing table and forwards to a backend service."
      }
    },
    {
      "id": "svc-users",
      "type": "component",
      "position": {
        "x": 900,
        "y": 60
      },
      "data": {
        "label": "User Service",
        "type": "service",
        "config": {
          "serviceName": "user-service",
          "endpoints": [
            "/users/*"
          ],
          "capacity": 40,
          "serviceTimeMs": 10,
          "queueLimit": 150,
          "errorRate": 0,
          "timeoutMs": 2000,
          "useCache": false
        },
        "description": "Application microservice. Processes matched endpoints, may consult the cache and its database."
      }
    },
    {
