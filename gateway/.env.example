PORT=8000
GATEWAY_HOST=127.0.0.1
NODE_ENV=development
GATEWAY_PROXY_TIMEOUT_MS=10000
JWT_ISSUER=dynamic-api-gateway
JWT_AUDIENCE=dynamic-api-gateway
JWT_ALGORITHM=RS256
JWT_ALLOW_LOCAL_JWKS=false
JWT_SECRET_REFRESH_INTERVAL_MS=300000
# Configure one verification source: AWS_SECRET_NAME (AWS) or JWT_LOCAL_JWKS_PATH (local).
# AWS_REGION=us-east-1
# AWS_SECRET_NAME=gateway/jwt/verification-jwks
# JWT_LOCAL_JWKS_PATH=C:\path\to\public.jwks.json
# JWT_DEMO_PRIVATE_KEY_PATH=C:\path\to\private.pem
MONGODB_URI=mongodb://127.0.0.1:27017/dynamic_api_gateway
FRONTEND_URL=http://localhost:5173
USER_SERVICE_URL=http://localhost:5001
USER_SERVICE_URL_2=http://localhost:5002
PRODUCT_SERVICE_URL=http://localhost:5003
ORDER_SERVICE_URL=http://localhost:5005
PAYMENT_SERVICE_URL=http://localhost:5007
BACKEND_HEALTH_CHECK_PATH=/health
BACKEND_HEALTH_CHECK_INTERVAL_MS=5000
BACKEND_HEALTH_CHECK_TIMEOUT_MS=1500
BACKEND_HEALTH_CHECK_FAILURE_THRESHOLD=2
BACKEND_HEALTH_CHECK_RECOVERY_THRESHOLD=1
