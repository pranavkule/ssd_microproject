[Unit]
Description=Dynamic L7 API Gateway
Wants=network-online.target user-service@5001.service user-service@5002.service product-service.service order-service.service payment-service.service
Requires=mongod.service
After=network-online.target mongod.service user-service@5001.service user-service@5002.service product-service.service order-service.service payment-service.service

[Service]
Type=simple
User=dynamic-gateway
Group=dynamic-gateway
WorkingDirectory=/opt/dynamic-api-gateway/gateway
EnvironmentFile=/etc/dynamic-api-gateway/gateway.env
ExecStartPre=/usr/bin/bash /opt/dynamic-api-gateway/deployment/scripts/wait-for-mongodb.sh
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
