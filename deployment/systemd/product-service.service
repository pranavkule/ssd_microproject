[Unit]
Description=Product Service
Wants=network-online.target
Requires=mongod.service
After=network-online.target mongod.service

[Service]
Type=simple
User=dynamic-gateway
Group=dynamic-gateway
WorkingDirectory=/opt/dynamic-api-gateway/services/product-service
EnvironmentFile=/etc/dynamic-api-gateway/services.env
Environment=PORT=5003
ExecStartPre=/usr/bin/bash /opt/dynamic-api-gateway/deployment/scripts/wait-for-mongodb.sh
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
